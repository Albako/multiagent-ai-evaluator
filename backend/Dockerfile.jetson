# ==========================================
# Stage 1: Builder (L4T base + CUDA 12.2 Toolkit)
# ==========================================
FROM nvcr.io/nvidia/l4t-base:r35.2.1 AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PYTHON_INSTALL_DIR="/opt/python"

WORKDIR /build

# Install build tools, and CUDA 12.2 toolkit
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    build-essential \
    cmake \
    curl \
    wget \
    ca-certificates \
    libgomp1 \
    && cd /tmp \
    && wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm -f cuda-keyring_1.1-1_all.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
    cuda-toolkit-12-2 \
    && apt-get download cuda-compat-12-2 \
    && dpkg-deb -x cuda-compat-12-2*.deb / \
    && rm -f cuda-compat-12-2*.deb \
    && ln -sfn /usr/local/cuda-12.2 /usr/local/cuda \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME="/usr/local/cuda-12.2"
ENV CUDAToolkit_ROOT="/usr/local/cuda-12.2"
ENV PATH="/usr/local/cuda-12.2/bin:${PATH}"

# Link CUDA stubs for build-time linking without active GPU access
RUN ln -s /usr/local/cuda-12.2/lib64/stubs/libcuda.so /usr/local/cuda-12.2/lib64/stubs/libcuda.so.1
ENV LD_LIBRARY_PATH="/usr/local/cuda-12.2/compat:/usr/local/cuda-12.2/lib64:/usr/local/cuda-12.2/lib64/stubs:${LD_LIBRARY_PATH}"

# Install precompiled python 3.11 and create isolated virtual environment
RUN uv python install 3.11 && \
    uv venv /opt/venv --python 3.11 --seed
ENV PATH="/opt/venv/bin:${PATH}"

COPY requirements.manager.txt .

# Limit parallel nvcc jobs to 8 to keep RAM usage well below 16GB during FA_ALL_QUANTS compilation
ENV CMAKE_BUILD_PARALLEL_LEVEL=8

# Target Volta architecture (SM 72) and ARMv8.2-A FP16/dotprod instructions of Carmel CPU
ENV CMAKE_ARGS="-DGGML_CUDA=on -DGGML_CUDA_FA_ALL_QUANTS=ON -DGGML_CUDA_NO_VMM=ON -DCMAKE_CUDA_ARCHITECTURES=72 -DCMAKE_BUILD_TYPE=Release"
ENV FORCE_CMAKE=1

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.manager.txt && \
    pip install --no-cache-dir --upgrade --force-reinstall --no-binary llama-cpp-python llama-cpp-python


# ==========================================
# Stage 2: Runtime (Lightweight L4T + CUDA 12.2 Runtime only)
# ==========================================
FROM nvcr.io/nvidia/l4t-base:r35.2.1 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install only CUDA 12.2 runtime libraries (cublas + cudart + compat) and OpenMP
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    libgomp1 \
    && cd /tmp \
    && wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm -f cuda-keyring_1.1-1_all.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
    cuda-cudart-12-2 \
    libcublas-12-2 \
    && apt-get download cuda-compat-12-2 \
    && dpkg-deb -x cuda-compat-12-2*.deb / \
    && rm -f cuda-compat-12-2*.deb \
    && apt-get purge -y --auto-remove wget \
    && ln -sfn /usr/local/cuda-12.2 /usr/local/cuda \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

# Copy standalone Python 3.11 interpreter and compiled virtualenv from builder
COPY --from=builder /opt/python /opt/python
COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:/usr/local/cuda-12.2/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda-12.2/compat:/usr/local/cuda-12.2/lib64:${LD_LIBRARY_PATH}"

COPY manager.py .

CMD ["sh", "-c", "uvicorn manager:app --host 0.0.0.0 --port ${MANAGER_PORT:-8001}"]
