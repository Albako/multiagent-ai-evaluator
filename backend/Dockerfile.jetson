FROM dustynv/l4t-text-generation:r35.2.1

# set python to not to write .pyc files
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# install basic system dependencies required for potential runtime operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    cmake \
    curl \
    wget \
    ca-certificates \
    && cd /tmp \
    && wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm -f cuda-keyring_1.1-1_all.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
    cuda-toolkit-12-2 \
    && apt-get download cuda-compat-12-2 \
    && dpkg-deb -x cuda-compat-12-2*.deb / \
    && rm -f cuda-compat-12-2*.deb \
    && ln -sfn /usr/local/cuda-12.2 /usr/local/cuda \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME="/usr/local/cuda-12.2"
ENV CUDAToolkit_ROOT="/usr/local/cuda-12.2"
ENV PATH="/usr/local/cuda-12.2/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda-12.2/compat:/usr/local/cuda-12.2/lib64:${LD_LIBRARY_PATH}"

# forcing compilation of the llama.cpp library for Volta architecture (SM 72)
ENV CMAKE_ARGS="-DGGML_CUDA=on -DGGML_CUDA_FA_ALL_QUANTS=ON -DGGML_CUDA_NO_VMM=ON -DCMAKE_CUDA_ARCHITECTURES=72 -DCMAKE_BUILD_TYPE=Release"
ENV FORCE_CMAKE=1

# Copy only requirements first to leverage Docker layer caching
COPY requirements.manager.txt .

# Install dependencies and force compilation of the newest llama-cpp-python from source
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.manager.txt && \
    pip install --no-cache-dir --upgrade --force-reinstall --no-binary llama-cpp-python llama-cpp-python

COPY manager.py .

CMD ["sh", "-c", "uvicorn manager:app --host 0.0.0.0 --port ${MANAGER_PORT:-8001}"]
