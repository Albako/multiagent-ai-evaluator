# .env.example
# =======================================

# Node 0 (API) IP
PC0_IP=00.00.00.00

# Node 1 (Worker 1 - RTX 4060 Laptop) IP
PC1_IP=zz.zz.zz.zz

# Node 2 (Worker 2 - Jetson AGX Xavier) IP
PC2_IP=yy.yy.yy.yy

# Node 3 (Worker 3 - MacBook Pro M1 Pro) IP
PC3_IP=xx.xx.xx.xx

# Node 4 (Judge - RTX 4070 Ti Desktop) IP
PC4_IP=xyz.xyz.xyz.xyz

# =======================================
# Default Family Selection per Mode
# Allowed families: "gemma", "qwen", "mixed"
# Can also be overridden dynamically in POST /system/init_mode
FAST_MODEL_FAMILY=gemma
PRO_MODEL_FAMILY=qwen
CODING_MODEL_FAMILY=mixed

# =======================================
# Model Family 1: GEMMA
GEMMA_WORKER_1_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
GEMMA_WORKER_2_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
GEMMA_WORKER_3_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
GEMMA_JUDGE_MODEL=gemma-4-31B-it-qat-UD-Q4_K_XL.gguf

# Model Family 2: QWEN (Qwen / Qwythos)
QWEN_WORKER_1_MODEL=Qwythos-9B-Claude-Mythos-5-1M-MTP-Q8_0.gguf
QWEN_WORKER_2_MODEL=Qwen3.5-9B-UD-Q6_K_XL.gguf
QWEN_WORKER_3_MODEL=Qwythos-9B-Claude-Mythos-5-1M-MTP-Q4_K_M.gguf
QWEN_JUDGE_MODEL=Qwen3.8-27B-UD-Q5_K_XL.gguf

# Model Family 3: MIXED (W1=Gemma, W2=Qwen, W3=Gemma, Judge=Qwen)
MIXED_WORKER_1_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
MIXED_WORKER_2_MODEL=Qwen3.5-9B-UD-Q6_K_XL.gguf
MIXED_WORKER_3_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
MIXED_JUDGE_MODEL=Qwen3.8-27B-UD-Q5_K_XL.gguf

# =======================================
# Internal API Endpoints
PC1_MANAGER_URL=http://${PC1_IP}:8001
PC2_MANAGER_URL=http://${PC2_IP}:8002
PC3_MANAGER_URL=http://${PC3_IP}:8003
PC4_MANAGER_URL=http://${PC4_IP}:8004
