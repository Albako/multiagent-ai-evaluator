# .env.example
# =======================================

# Node 0 (API) IP
PC0_IP=00.00.00.00

# Node 1 (Worker 1) IP
PC1_IP=zz.zz.zz.zz

# Node 2 (Worker 2) IP
PC2_IP=yy.yy.yy.yy

# Node 3 (Worker 3) IP
PC3_IP=xx.xx.xx.xx

# Node 4 (Judge) IP
PC4_IP=xyz.xyz.xyz.xyz

# =======================================
# Mode configuration
# Fast - uses only one model on PC4.
FAST_MODEL=gemma-4-31B-it-qat-UD-Q4_K_XL.gguf

# Pro
PRO_WORKER_1_MODEL=Qwythos-9B-Claude-Mythos-5-1M-MTP-Q8_0.gguf
PRO_WORKER_2_MODEL=Qwen3.5-9B-UD-Q6_K_XL.gguf
PRO_WORKER_3_MODEL=Qwythos-9B-Claude-Mythos-5-1M-MTP-Q4_K_M.gguf
PRO_JUDGE_MODEL=Qwen3.8-27B-UD-Q5_K_XL.gguf

# Coding
CODING_WORKER_1_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
CODING_WORKER_2_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
CODING_WORKER_3_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
CODING_JUDGE_MODEL=gemma-4-31B-it-qat-UD-Q4_K_XL.gguf

# ======================================
# Internal API Endpoints
PC1_MANAGER_URL=http://${PC1_IP}:8001
PC2_MANAGER_URL=http://${PC2_IP}:8002
PC3_MANAGER_URL=http://${PC3_IP}:8003
PC4_MANAGER_URL=http://${PC4_IP}:8004
